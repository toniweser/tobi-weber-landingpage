    "gh-pages": "^6.3.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "svelte": "^5.51.3",
    "svelte-check": "^4.4.0",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.8.1",
